meta {
  name: 06-Get EDR for Transfer (Anon)
  type: http
  seq: 6
  tags: [
    exchange-anonymized-data
  ]
}

get {
  url: {{SUPPLIER_EDC}}/{{MANAGEMENT_PATH}}/v3/edrs/{{DTR_TRANSFER_PROCESS_ID}}/dataaddress?auto_refresh=true
  body: none
  auth: apikey
}

params:query {
  auto_refresh: true
}

auth:apikey {
  key: X-API-KEY
  value: {{SUPPLIER_EDC_API_KEY}}
  placement: header
}

script:post-response {
  const jsonData = res.getBody();
  bru.setVar("DTR_EDR_AUTH", jsonData.authorization);
  bru.setVar("DTR_EDR_ENDPOINT", jsonData.endpoint);
}

tests {
  if (bru.getVar("__retryPending")) return;
  test("Status code is 200", function () {
      expect(res.getStatus()).to.equal(200);
  });
}
