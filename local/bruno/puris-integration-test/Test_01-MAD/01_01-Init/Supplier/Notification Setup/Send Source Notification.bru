meta {
  name: Send Source Notification
  type: http
  seq: 3
}

post {
  url: {{SUPPLIER_PURIS_BACKEND}}/catena/demand-and-capacity-notification/request
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-Api-Key: {{SUPPLIER_PURIS_BACKEND_API_KEY}}
  edc-bpn: BPNL8888888888YY
}

script:pre-request {
  const sentDateTime = new Date();
  const startDateOfEffect = new Date(now.getTime() - 24 * 60 * 60 * 1000); // 1 day ago
  const expectedEndDateOfEffect = new Date(now.getTime() + 30 * 24 * 60 * 60 * 1000); // 30 days in the future

  bru.setVar("sentDateTime", sentDateTime.toISOString());
  bru.setVar("startDateOfEffect", startDateOfEffect.toISOString());
  bru.setVar("expectedEndDateOfEffect", expectedEndDateOfEffect.toISOString());
}

body:json {
    {
        "header": {
            "messageId": "3b4edc05-e214-47a1-b0c2-1d831cdd9ba9",
            "context": "CX-DemandAndCapacityNotificationAPI-Receive:2.0.0",
            "receiverBpn": "{{SUPPLIER_BPNL}}",
            "senderBpn": "{{NOTIFICATION_SOURCE_PARTNER_BPNL}}",
            "sentDateTime": "{{sentDateTime}}",
            "version": "3.0.0"
        },
        "content": {
            "demandAndCapacityNotification": {
                "notificationId": "d9452f24-3bf3-4134-b3eb-68858f1b2362",
                "sourceDisruptionId": "c69cb3e4-16ad-43c3-82b9-0deac75ecf9e",
                "text": "Capacity reduction due to ongoing strike.",
                "effect": "capacity-reduction",
                "leadingRootCause": "strike",
                "status": "open",
                "contentChangedAt": "{{startDateOfEffect}}",
                "startDateOfEffect": "{{startDateOfEffect}}",
                "expectedEndDateOfEffect": "{{expectedEndDateOfEffect}}",
                "affectedSitesSender": [],
                "affectedSitesRecipient": [],
                "materialsAffected": [],
                "relatedNotificationIds": []
            }
        }
    }
}

tests {
  test("response is ok", function() {
      expect(res.getStatus()).to.equal(200);
  })
}
