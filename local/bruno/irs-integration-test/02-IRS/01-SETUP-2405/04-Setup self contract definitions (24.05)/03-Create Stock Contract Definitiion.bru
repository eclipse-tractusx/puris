  body: json
  auth: inherit
}

body:json {
  {
      "@context": {
          "@vocab": "https://w3id.org/edc/v0.0.1/ns/"
      },
      "@id": "Manual_AnonymizedItemStockContractDefinition_for_{{OWN_BPNL}}",
      "@type": "ContractDefinition",
      "accessPolicyId": "{{OWN_BPNL}}_policy",
      "contractPolicyId": "Contract_Policy_for_Profile_2405",
      "assetsSelector" : {
          "@type" : "CriterionDto",
          "operandLeft": "{{EDC_NAMESPACE}}id",
          "operator": "=",
          "operandRight": "itemstockanonymizedsubmodel-api-asset@{{OWN_BPNL}}"
      }
  }
}

tests {
  test("Status code is 200", function () {
      expect(res.getStatus()).to.equal(200);
  });
