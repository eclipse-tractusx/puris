meta {
  name: Get Reported Data Exchange Request as Supplier
  type: http
  seq: 2
}

get {
  url: {{SUPPLIER_PURIS_BACKEND}}/catena/data-exchange-request/reported
  body: none
  auth: none
}

headers {
  X-Api-Key: {{SUPPLIER_PURIS_BACKEND_API_KEY}}
}

script:pre-request {
  bru.setVar("retryUntilMinLength", 1);
}

tests {
  if (bru.getVar("__retryPending")) return;

  test("response is ok", function() {
      expect(res.getStatus()).to.equal(200);
  });

  const body = res.getBody();
  test("Verify response contains one reported data exchange request object", function () {
      expect(body).to.be.an("array").with.lengthOf(1);
  });

  if (Array.isArray(body) && body.length > 0) {
    bru.setVar("reportedRequestUuid", body[0].uuid);
  }
}
