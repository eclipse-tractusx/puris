meta {
  name: 03-Get DTR Negotation by id (Anon)
  type: http
  seq: 3
  tags: [
    exchange-anonymized-data
  ]
}

get {
  url: {{SUPPLIER_EDC}}/{{MANAGEMENT_PATH}}/v3/contractnegotiations/{{DTR_NEGOTIATION_ID}}
  body: none
  auth: apikey
}

script:pre-request {
  bru.setVar("retryUntilField", "state");
  bru.setVar("retryUntilValue", "FINALIZED");
}

auth:apikey {
  key: X-API-KEY
  value: {{SUPPLIER_EDC_API_KEY}}
  placement: header
}

script:post-response {
  const jsonData = res.getBody();
  bru.setVar("DTR_CONTRACT_AGREEMENT_ID", jsonData.contractAgreementId);
}

tests {
  if (bru.getVar("__retryPending")) return;
  test("Status code is 200", function () {
      expect(res.getStatus()).to.equal(200);
  });
}
