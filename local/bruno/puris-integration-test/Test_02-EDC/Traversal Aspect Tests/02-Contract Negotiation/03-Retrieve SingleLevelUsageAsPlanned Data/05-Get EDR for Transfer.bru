meta {
  name: 05-Get EDR for Transfer SLUAP
  type: http
  seq: 5
  tags: [
    single-level-usage-as-planned
  ]
}

get {
  url: {{SUPPLIER_EDC}}/{{MANAGEMENT_PATH}}/v3/edrs/{{SLUAP_TRANSFER_PROCESS_ID}}/dataaddress?auto_refresh=true
  body: none
  auth: inherit
}

params:query {
  auto_refresh: true
}

script:post-response {
  const jsonData = res.getBody();
  bru.setVar("SLUAP_EDR_ENDPOINT", jsonData.endpoint);
  bru.setVar("SLUAP_EDR_AUTH", jsonData.authorization);
}

tests {
  if (bru.getVar("__retryPending")) return;
  test("Status code is 200", function () {
      expect(res.getStatus()).to.equal(200);
  });
}