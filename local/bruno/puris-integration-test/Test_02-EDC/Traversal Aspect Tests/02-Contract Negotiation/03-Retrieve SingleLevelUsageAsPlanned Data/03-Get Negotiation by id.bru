meta {
  name: 03-Get Negotiation by id SLUAP
  type: http
  seq: 3
  tags: [
    single-level-usage-as-planned
  ]
}

script:pre-request {
  bru.setVar("retryUntilField", "state");
  bru.setVar("retryUntilValue", "FINALIZED");
}

get {
  url: {{SUPPLIER_EDC}}/{{MANAGEMENT_PATH}}/v3/contractnegotiations/{{SLUAP_NEGOTIATION_ID}}
  body: none
  auth: inherit
}

script:post-response {
  const jsonData = res.getBody();
  bru.setVar("SLUAP_CONTRACT_AGREEMENT_ID", jsonData.contractAgreementId);
}

tests {
  if (bru.getVar("__retryPending")) return;
  test("Status code is 200", function () {
      expect(res.getStatus()).to.equal(200);
  });

  test("Negotiation is finalized", function () {
      expect(res.getBody().state).to.equal("FINALIZED");
  });
}