meta {
  name: 1-Authenticate
  type: http
  seq: 1
  tags: [
    seed-discoveries
  ]
}

post {
  url: {{OWN_DISCOVERY_IDP_URL}}/auth/realms/{{OWN_DISCOVERY_IDP_REALM}}/protocol/openid-connect/token
  body: formUrlEncoded
  auth: none
}

headers {
  Content-Type: application/x-www-form-urlencoded
}

body:form-urlencoded {
  grant_type: client_credentials
  client_id: {{OWN_DISCOVERY_IDP_CLIENT_ID}}
  client_secret: {{OWN_DISCOVERY_IDP_CLIENT_SECRET}}
}

tests {
  test("Save access token", function () {
      var jsonData = res.getBody();
      bru.setVar("BPN_DISCOVERY_BEARER_TOKEN", jsonData.access_token);
  });
}
